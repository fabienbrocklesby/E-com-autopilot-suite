{
	"name": "email-dash-api",
	"version": "0.1.0",
	"tasks": {
		"dev": "deno run --watch --allow-net --allow-env --allow-read main.ts",
		"start": "deno run --allow-net --allow-env --allow-read main.ts",
		"migrate": "deno run --allow-net --allow-env --allow-read db/migrate.ts",
		"lint": "deno lint",
		"fmt": "deno fmt",
		"test": "deno test --allow-net --allow-env --allow-read"
	},
	"imports": {
		"hono": "npm:hono",
		"hono/cors": "npm:hono/cors",
		"hono/streaming": "npm:hono/streaming"
	},
	"compilerOptions": {
		"strict": true
	},
	"lint": {
		"rules": {
			"tags": [
				"recommended"
			]
		}
	},
	"fmt": {
		"indentWidth": 2,
		"lineWidth": 100
	}
}
