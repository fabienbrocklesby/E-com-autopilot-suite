# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
# Postgres host (service name in docker-compose)
PGHOST=postgres
# Postgres port
PGPORT=5432
# Postgres database name
PGDATABASE=emaildash
# Postgres username
PGUSER=emaildash
# Postgres password — generate a strong random string
PGPASSWORD=changeme

# Full connection string (used as fallback / convenience)
DATABASE_URL=postgres://emaildash:changeme@postgres:5432/emaildash

# ─── API ────────────────────────────────────────────────────────────────────────
# Port the Deno API server listens on
API_PORT=8000
# Secret used to sign session/auth tokens — generate with: openssl rand -hex 32
API_SECRET=changeme_api_secret_32_bytes_hex

# ─── Google OAuth ───────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Publicly reachable base URL of the API (used to build OAuth callback URL)
# For local dev this is the public tunnel URL or localhost
API_BASE_URL=http://localhost:8000

# ─── OpenAI ─────────────────────────────────────────────────────────────────────
# API key from platform.openai.com
OPENAI_API_KEY=sk-...

# Default model for completions
OPENAI_MODEL=gpt-4o

# ─── Gmail Pub/Sub ───────────────────────────────────────────────────────────────
# Google Cloud Pub/Sub topic name for Gmail push notifications
# Format: projects/<project-id>/topics/<topic-name>
PUBSUB_TOPIC=projects/your-project/topics/gmail-push

# ─── Frontend ────────────────────────────────────────────────────────────────────
# Port the SvelteKit frontend listens on
FRONTEND_PORT=3000
# Public-facing API base URL (accessible from the browser)
PUBLIC_API_BASE_URL=http://localhost:8000
